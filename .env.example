# Redolve Environment Variables Example
# Cloudflare Worker Secrets & Local Development Configuration
# Copy this file to .dev.vars and fill in actual values. DO NOT COMMIT .dev.vars.

# Google Gemini API Key (Required for AI taxonomy keywording)
GEMINI_API_KEY=your_gemini_api_key_here

# better-auth Session Signature Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Admin Google Accounts Whitelist (comma-separated emails)
# Controls access to /api/admin/taxonomy/seed and the admin UI block in Settings
ADMIN_EMAILS=admin@yourdomain.com

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Provider Selection (default: gemini)
AI_PROVIDER=gemini

# Allowed Origins for CORS (comma separated for production/staging)
ALLOWED_ORIGINS=http://localhost:5173,https://redolve.pages.dev

# Environment Name: development | production
ENV=development
