{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redolve-api",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 2026-10-07: Gemini 地區拒絕已由此 placement 配置排除（使用者驗證）。
  "placement": {
    "region": "gcp:asia-east1"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/share/*",
      "/assets/*"
    ]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "487878253671-eg14d8s8fd1th57f3ugd8kivrqmultbl.apps.googleusercontent.com"
  },
  "ratelimits": [
    { "name": "GUEST_AI_LIMITER", "namespace_id": "94272501", "simple": { "limit": 20, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "94272502", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "redolve-db",
      "database_id": "966ad241-9a03-4719-99d6-c18314d7bf94",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "redolve-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "b09131c5f54446f6bff12e368190572a"
    }
  ],
   "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
